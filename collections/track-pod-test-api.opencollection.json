{
  "opencollection": "1.0.0",
  "info": {
    "name": "Track-POD Address Test API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Test",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Test authorization and rate limits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/Test"
          },
          "docs": "Test authorization and rate limits"
        }
      ]
    }
  ],
  "bundled": true
}