          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/Driver"
          },
          "docs": "Get drivers"
        },
        {
          "info": {
            "name": "Add driver",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/Driver",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add driver"
        },
        {
          "info": {
            "name": "Update driver",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/Driver",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update driver"
        }
      ]
    }
  ],
  "bundled": true
