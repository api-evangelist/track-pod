            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get driver by Username"
        },
        {
          "info": {
            "name": "Delete Driver by id.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
